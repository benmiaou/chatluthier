{
  "name": "chatluthier",
  "version": "1.0.0",
  "description": "Le Chat Luthier is your immersive sound companion for enhancing role-playing games, storytelling sessions, or any experience that benefits from atmospheric audio. Use `npm run local` or `npm run npm:local` to start the local development server.",
  "main": "main.js",
  "scripts": {
    "build": "vite build",
    "preview": "vite preview",
    "dev": "node srv/server.js",
    "dev:client": "vite",
    "dev:server": "nodemon srv/server.js",
    "dev:watch": "concurrently \"vite\" \"nodemon srv/server.js\"",
    "start": "vite build && node srv/server.js",
    "local": "npm run dev",
    "npm:local": "npm run dev",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@mantine/core": "^8.3.15",
    "@mantine/hooks": "^8.3.15",
    "@mantine/modals": "^8.3.15",
    "@mantine/notifications": "^8.3.15",
    "@tabler/icons-react": "^3.36.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "google-auth-library": "^9.15.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "ws": "^8.17.0"
  },
  "keywords": [
    "sound",
    "role-playing",
    "audio",
    "soundboard",
    "ambiance",
    "storytelling",
    "gaming"
  ],
  "author": "Benjamin Thibault",
  "license": "ISC"
}
