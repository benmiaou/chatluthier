{
  "name": "chatluthier",
  "version": "1.0.0",
  "description": "Le Chat Luthier is your immersive sound companion for enhancing role-playing games, storytelling sessions, or any experience that benefits from atmospheric audio. Use `npm run local` or `npm run npm:local` to start the local development server.",
  "main": "main.js",
  "license": "ISC",
  "scripts": {
    "build": "vite build",
    "preview": "vite preview",
    "dev": "node srv/server.js",
    "dev:client": "vite",
    "dev:server": "nodemon srv/server.js",
    "dev:watch": "concurrently \"vite\" \"nodemon srv/server.js\"",
    "dev:watch:logs": "concurrently \"node scripts/vite-with-logs.js\" \"nodemon srv/server-with-logs.js\"",
    "start": "vite build && node srv/server.js",
    "local": "npm run dev",
    "npm:local": "npm run dev",
    "test": "node tests/run_all_tests.js",
    "test:auth": "node tests/test_auth_system.js",
    "test:cookies": "node tests/test_cookie_transmission.js",
    "test:jwt": "node tests/test_jwt_direct.js",
    "test:external-unit": "node tests/test_external_sounds_unit.js",
    "test:external-api": "node tests/test_external_sounds_api.js",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "prepare": "husky install",
    "precommit": "npm run lint && npm run check-format"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^8.0.0",
    "nodemon": "^3.1.4",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@mantine/core": "^8.3.15",
    "@mantine/hooks": "^8.3.15",
    "@mantine/modals": "^8.3.15",
    "@mantine/notifications": "^8.3.15",
    "@sentry/react": "^10.42.0",
    "@sentry/replay": "^7.116.0",
    "@sentry/tracing": "^7.120.4",
    "@tabler/icons-react": "^3.36.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "helmet": "^8.1.0",
    "jsdom": "^28.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0",
    "react": "^19.2.4",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "sqlite3": "^5.1.7",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.17.0"
  },
  "keywords": [
    "sound",
    "role-playing",
    "audio",
    "soundboard",
    "ambiance",
    "storytelling",
    "gaming"
  ],
  "author": "Benjamin Thibault",
  "type": "commonjs",
  "overrides": {
    "tar": "^7.5.9",
    "node-gyp": "^10.3.1"
  }
}
