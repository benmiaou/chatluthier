#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Run ESLint
npm run lint
if [ $? -ne 0 ]; then
  echo "❌ ESLint failed, commit aborted"
  exit 1
fi

# Run Prettier check
npm run check-format
if [ $? -ne 0 ]; then
  echo "❌ Prettier check failed, commit aborted"
  exit 1
fi

echo "✅ All checks passed, commit can proceed"
