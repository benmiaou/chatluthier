# Frontend Configuration
REACT_APP_SENTRY_DSN=your_sentry_dsn_here

# API Configuration (use relative paths for development, full URLs for production)
# Development (local):
# VITE_API_BASE_URL=
# 
# Production (dev server):
# VITE_API_BASE_URL=https://dev.chatluthier.org:4000
#
# Production (main server):
# VITE_API_BASE_URL=https://chatluthier.org

# WebSocket Configuration (optional, defaults to window.location.hostname)
# Development (local):
# VITE_WS_HOST=localhost
#
# Production (dev server):
# VITE_WS_HOST=dev.chatluthier.org
#
# Production (main server):
# VITE_WS_HOST=chatluthier.org

# Environment
# NODE_ENV=development  # Default
# NODE_ENV=production   # For production deployment
=======

# Backend Configuration (for Winston logging)
LOG_LEVEL=info
LOG_FILE=./logs/app.log
MAX_LOG_FILE_SIZE=10m
MAX_LOG_FILES=5

# Environment
NODE_ENV=development
