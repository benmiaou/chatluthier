# ──────────────────────────────────────────────────────────────
# ChatLuthier — environment configuration template
# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.
# ──────────────────────────────────────────────────────────────

# ── Node environment ───────────────────────────────────────────
NODE_ENV=development

# ── Backend port ──────────────────────────────────────────────
# Port for the Express server (can also be passed as: node server.js <port>)
PORT=3000

# ── CORS allowed origins ──────────────────────────────────────
# Comma-separated list of origins permitted to call the API.
# Dev local (default when unset):
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
#
# Example for a staging server:
# CORS_ORIGINS=https://staging.example.com
#
# Example for production:
# CORS_ORIGINS=https://example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── CSP WebSocket origins ─────────────────────────────────────
# Comma-separated list of ws:// or wss:// origins for Content-Security-Policy.
# Dev local (default when unset):
# WS_ORIGINS=ws://localhost:3001,wss://localhost:3001
#
# Example for production with a reverse-proxy WebSocket path:
# WS_ORIGINS=wss://example.com
WS_ORIGINS=ws://localhost:3001,wss://localhost:3001

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=./logs/app.log
MAX_LOG_FILE_SIZE=10m
MAX_LOG_FILES=5

# ── Frontend — API base URL ───────────────────────────────────
# Leave empty in dev (Vite proxy handles it).
# Set to full server URL in production builds:
# VITE_API_BASE_URL=https://example.com
VITE_API_BASE_URL=

# ── Frontend — Vite dev proxy backend port ────────────────────
# Port that vite.config.ts proxies API requests to.
# Must match PORT above.
BACKEND_PORT=3000

# ── Frontend — WebSocket connection ───────────────────────────
# VITE_WS_HOST   : WebSocket server hostname (defaults to window.location.hostname)
# VITE_WS_PORT   : WebSocket server port     (defaults to 3001 on localhost, httpPort+1 elsewhere)
# VITE_WS_PATH   : WebSocket URL path suffix (defaults to empty — set to /ws/ if behind a reverse proxy)
#
# Dev local — these can be left unset (defaults work):
# VITE_WS_HOST=localhost
# VITE_WS_PORT=3001
# VITE_WS_PATH=
#
# Staging / production examples:
# VITE_WS_HOST=example.com
# VITE_WS_PORT=443
# VITE_WS_PATH=/ws/
VITE_WS_HOST=
VITE_WS_PORT=
VITE_WS_PATH=

# ── Spotify OAuth ─────────────────────────────────────────────
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id
VITE_SPOTIFY_REDIRECT_URI=http://localhost:5173/callback

# ── Deezer OAuth ──────────────────────────────────────────────
VITE_DEEZER_APP_ID=your_deezer_app_id
VITE_DEEZER_REDIRECT_URI=http://localhost:5173/deezer-callback

# ── SoundCloud OAuth ──────────────────────────────────────────
VITE_SOUNDCLOUD_CLIENT_ID=your_soundcloud_client_id
VITE_SOUNDCLOUD_REDIRECT_URI=http://localhost:5173/soundcloud-callback
SOUNDCLOUD_CLIENT_SECRET=your_soundcloud_client_secret
